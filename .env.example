# PostgreSQL
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=jobpass
POSTGRES_DB=job_search
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_LLM_MODEL=phi3:mini
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=200

# HuggingFace embedding (local)
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Crawl
MAX_PAGES=5

# Notify
NOTIFY_MIN_SCORE=70

# Email (Gmail: dùng App Password, không dùng mật khẩu thường)
EMAIL_SENDER=you@gmail.com
EMAIL_RECIPIENT=you@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password